{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Legal terminology knowledge base",
  "type": "object",
  "required": ["schema_version", "source_checked_at", "description", "concepts"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "source_checked_at": {"type": "string", "format": "date"},
    "description": {"type": "string", "minLength": 1},
    "concepts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["concept_id", "legal_term", "lay_terms", "relation_type", "scope_note", "law_id", "law_name", "article_refs", "effective_from", "effective_to", "source_document_ids", "annotation_status", "annotation_note"],
        "properties": {
          "concept_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "legal_term": {"type": "string", "minLength": 1},
          "lay_terms": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "relation_type": {"enum": ["exact_synonym", "contextual_mapping", "broader_term", "narrower_term", "related_not_synonym"]},
          "scope_note": {"type": "string", "minLength": 1},
          "law_id": {"type": "string", "minLength": 1},
          "law_name": {"type": "string", "minLength": 1},
          "article_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^제[0-9]+조(?:의[0-9]+)?$"}},
          "effective_from": {"type": "string", "format": "date"},
          "effective_to": {"type": ["string", "null"], "format": "date"},
          "source_document_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "annotation_status": {"enum": ["draft", "reviewed", "rejected"]},
          "annotation_note": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
