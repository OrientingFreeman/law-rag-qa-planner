{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Business legal RAG evaluation cases",
  "type": "array",
  "minItems": 12,
  "maxItems": 12,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "case_id",
      "question",
      "category",
      "difficulty",
      "domain",
      "top_k",
      "expected_law_id",
      "expected_article_nos",
      "expected_answer_points",
      "expected_abstain",
      "annotation_note"
    ],
    "properties": {
      "case_id": {"type": "string", "pattern": "^business-[a-z0-9-]+$"},
      "question": {"type": "string", "minLength": 10},
      "category": {
        "enum": [
          "direct_statute_retrieval",
          "lay_to_legal_mapping",
          "similar_provision_disambiguation",
          "multi_requirement"
        ]
      },
      "difficulty": {"enum": ["easy", "medium", "hard"]},
      "domain": {"enum": ["electronic_finance", "digital_business", "intellectual_property"]},
      "top_k": {"type": "integer", "minimum": 1, "maximum": 10},
      "expected_law_id": {"type": "string", "minLength": 1},
      "expected_article_nos": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {"type": "string", "pattern": "^제[0-9]+조(?:의[0-9]+)?$"}
      },
      "expected_answer_points": {
        "type": "array",
        "minItems": 1,
        "items": {"type": "string", "minLength": 5}
      },
      "expected_abstain": {"const": false},
      "annotation_note": {"type": "string", "minLength": 5}
    }
  }
}
