{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reviewed hard-negative training candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidate_id", "schema_version", "candidate_pool_version", "query", "domain", "category", "positive_documents", "negative_documents", "hard_negative_documents", "source", "failure_types", "review_status", "created_at"],
  "properties": {
    "candidate_id": {"type": "string", "pattern": "^hn_[0-9a-f]{24}$"},
    "schema_version": {"type": "string"},
    "candidate_pool_version": {"type": "string"},
    "query": {"type": "string", "minLength": 1},
    "domain": {"type": "string"},
    "category": {"type": "string"},
    "positive_documents": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/document"}},
    "negative_documents": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/document"}},
    "hard_negative_documents": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/document"}},
    "source": {
      "type": "object",
      "required": ["benchmark_id", "method", "case_id", "dataset_id", "dataset_version", "ground_truth_version", "corpus_sha256"],
      "properties": {
        "benchmark_id": {"type": "string"}, "method": {"type": "string"},
        "case_id": {"type": "string"}, "dataset_id": {"type": "string"},
        "dataset_version": {"type": "string"}, "ground_truth_version": {"type": "string"},
        "corpus_sha256": {"type": "string"}
      }
    },
    "failure_types": {"type": "array", "items": {"enum": ["wrong_top1", "retrieval_miss", "over_retrieval"]}},
    "review_status": {"const": "review_required"},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "document": {
      "type": "object",
      "required": ["document_id", "law_id", "law_name", "article_no", "text", "source_document_ids"],
      "properties": {
        "document_id": {"type": "string"}, "law_id": {"type": "string"},
        "law_name": {"type": "string"}, "article_no": {"type": "string"},
        "text": {"type": "string", "minLength": 1},
        "source_document_ids": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
