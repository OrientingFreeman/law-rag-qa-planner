# Optional: use a specific dotenv file instead of project-root .env
# LAW_RAG_ENV_FILE=/absolute/path/to/.env

# 국가법령정보 공동활용 API
LAW_API_OC=
LAW_API_SEARCH_URL=https://www.law.go.kr/DRF/lawSearch.do
LAW_API_SERVICE_URL=https://www.law.go.kr/DRF/lawService.do

# LLM provider: disabled | deterministic | openai | openai_compatible
# openai: OpenAI Responses API (/v1/responses)
# openai_compatible: Chat Completions compatible API (/v1/chat/completions)
LAW_RAG_LLM_PROVIDER=deterministic
LAW_RAG_LLM_API_KEY=
LAW_RAG_LLM_MODEL=gpt-4.1-mini
LAW_RAG_LLM_BASE_URL=https://api.openai.com/v1
LAW_RAG_LLM_TIMEOUT=30
LAW_RAG_LLM_MAX_RETRIES=2

# Prompt and observability
LAW_RAG_PROMPT_DIR=prompts
LAW_RAG_PROMPT_VERSION=answer_v1
LAW_RAG_LOG_DIR=logs

# API / container
LAW_RAG_HOST=0.0.0.0
LAW_RAG_PORT=8000
LAW_RAG_RELOAD=false
LAW_API_CACHE_DIR=data/official_cache

# 공개 포트폴리오 데모 설정
LAW_RAG_PUBLIC_DEMO=false
LAW_RAG_ENABLE_EVALUATION_RUN=true
LAW_RAG_DEMO_MAX_REQUESTS=20
LAW_RAG_DEMO_WINDOW_SECONDS=3600
